# Plaintext loopback development must bind to an exact numeric loopback host.
# LAN deployments may use 0.0.0.0 only with an HTTPS PUBLIC_BASE_URL.
HOST=127.0.0.1
PORT=4207
PUBLIC_BASE_URL=http://localhost:4207
# Loopback HTTP is the only plaintext mode. Any HTTPS public origin requires
# both TLS files unless a separately validated termination mode is introduced.
# Recursive data-boundary ancestor checks remain fail-closed by default. Set
# this to true only for a disposable loopback HTTP repository fixture; HTTPS
# deployments reject the opt-out.
ALLOW_INSECURE_LOOPBACK_DATA_BOUNDARY=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# The only non-secret translation route input. This approved JSON artifact pins
# the provider, selectable/default modes, service endpoints, models, voice,
# glossary egress, evidence controls, retention policy, and consent policy.
# The checked-in manufacturing POC has unverified trainingUse and
# serviceRetention assurances. It is synthetic-benchmark-only: POST
# /api/sessions rejects it with synthetic_only_profile. It is not a production
# approval. Use an immutable deployment path and its lowercase canonical
# SHA-256 hash.
PROCESSING_PROFILE_PATH=./profiles/manufacturing-poc.json
PROCESSING_PROFILE_SHA256=48ccc7bd514c92c11d6d6e448fb714daf720b87891536d96efacc239e8948294

# Required immutable deployment identity. Set this to the lowercase SHA-256
# derived from the exact clean Git commit deployed to this server; never use a
# package version, a generated fallback, or a placeholder in a real launch.
# It is shown only to authenticated operators.
DEPLOYMENT_BUILD_SHA256=<sha256-of-exact-deployed-git-commit>

# Server-only provider credentials. The checked-in reference profile selects
# openai_controlled and therefore requires OPENAI_API_KEY. A different approved
# profile determines which one is required; neither key is exposed to browser
# links, QR codes, evidence, or client JavaScript.
OPENAI_API_KEY=
PALABRA_API_KEY=

# Operator and evidence-governance credentials are separate scopes.
# RETENTION_OWNER_ID is the deployment-assigned data owner; EVIDENCE_REVIEWER_ID
# is the deployment-assigned bilingual-reviewer role. Server freezes both distinct
# identities into every new session's sealed evidence-review grant. Only the
# matching owner/reviewer bearer may review that session's sealed retention,
# metadata, or bounded audio; an operator or phone/participant grant never can.
# “Bilingual reviewer” is an authorization assignment, not a language-skill
# attestation. The owner alone may extend/delete evidence, delete a glossary
# version, or create a plaintext export. Tokens must be 32-512 non-whitespace
# characters and must never be reused.
OPERATOR_TOKEN=
RETENTION_OWNER_ID=
RETENTION_OWNER_TOKEN=
EVIDENCE_REVIEWER_ID=
EVIDENCE_REVIEWER_TOKEN=

# browser_pair creates two phone-browser endpoints. fake_telephony is only an
# in-process G.711 test fixture; it is not a SIP/PSTN carrier integration.
MEDIA_PROFILE=browser_pair

# v3 evidence artifacts and the encrypted glossary use five distinct,
# non-nested filesystem security roots. Every root must be a strict descendant
# of the dedicated resolved security data parent (the default is ./data); an
# absolute path is valid only when it remains under that parent.
# For a remote HTTPS deployment, replace this and every root below with
# absolute paths under a dedicated directory outside the deployment cwd.
SECURITY_DATA_DIRECTORY=./data
EVIDENCE_ARCHIVE_DIRECTORY=./data/evidence/archive
EVIDENCE_KEY_DIRECTORY=./data/evidence/keys
EVIDENCE_EXPORT_DIRECTORY=./data/evidence/exports
# This root also retains the detached content-free evidence-review audit chain
# after evidence/key/export data is deleted.
EVIDENCE_RECEIPT_DIRECTORY=./data/evidence/receipts
# Fresh/dedicated encrypted glossary root. Legacy plaintext glossary files are
# intentionally not read or migrated.
GLOSSARY_DIRECTORY=./data/glossaries

# Required: canonical base64 for exactly 32 random bytes. Generate one with
# `pnpm keygen`; this root key is distinct from provider API keys.
EVIDENCE_ROOT_KEY_BASE64=
LOG_LEVEL=info
