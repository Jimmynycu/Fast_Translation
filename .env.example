HOST=0.0.0.0
PORT=4207
PUBLIC_BASE_URL=http://localhost:4207
TLS_CERT_PATH=
TLS_KEY_PATH=

# 32-512 character bearer secret for the operator UI. Set this explicitly for a
# usable launch URL: <PUBLIC_BASE_URL>/#access=<OPERATOR_TOKEN>. Never share it
# with participants or commit it. When omitted, the server generates one but
# deliberately redacts the access fragment from its startup log.
OPERATOR_TOKEN=

# Select exactly one server-side provider at startup. The operator UI can choose
# only a mode advertised by that provider for each new session.
#   palabra | openai_native | openai_controlled
TRANSLATION_PROVIDER=openai_controlled
#   fast | balanced | accurate (openai_native does not support accurate)
TRANSLATION_MODE=balanced

# Required only for TRANSLATION_PROVIDER=openai_native or openai_controlled.
# This key never belongs in browser code, QR links, participant URLs, API
# payloads, evidence, source control, or issue text.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Required only for TRANSLATION_PROVIDER=palabra. Palabra is an independent
# server-side speech-to-speech alternative; this key has the same no-client and
# no-QR exposure rule as OPENAI_API_KEY.
PALABRA_API_KEY=
# 20-320 inclusive, in 20 ms increments.
PALABRA_INPUT_CHUNK_MS=320

# browser_pair creates two phone-browser WebSocket endpoints. fake_telephony is
# an in-process G.711 mu-law fixture only; it is not a SIP/PSTN/carrier service
# and it does not create QR/browser media endpoints.
MEDIA_PROFILE=browser_pair

# encrypted_local requires EVIDENCE_KEY_BASE64. Use in_memory for a disposable
# smoke without persistent evidence.
EVIDENCE_PROFILE=encrypted_local
EVIDENCE_DIRECTORY=./data/evidence
GLOSSARY_DIRECTORY=./data/glossaries

# 32 random bytes encoded as base64. Generate with: pnpm keygen
EVIDENCE_KEY_BASE64=
LOG_LEVEL=info
