HOST=0.0.0.0
PORT=4207
PUBLIC_BASE_URL=http://localhost:4207
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional 32+ character bearer secret for the operator UI. When omitted, a
# fresh random token is generated at startup and printed only in operatorUrl.
OPERATOR_TOKEN=

# Required for OpenAI-backed profiles. Never expose this key to browsers.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# Optional Palabra server-side API key. Required only when
# TRANSLATION_PROFILE=palabra_live; never expose this key to browsers.
PALABRA_API_KEY=
PALABRA_INPUT_CHUNK_MS=320

OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Provider-free Harness evaluation. These are fixture transcripts injected
# after real audio frames traverse the selected media adapter; they do not
# claim acoustic STT accuracy.
LOCAL_EVAL_TRANSCRIPT_A_TO_B=Verify the mistake proofing fixture.
LOCAL_EVAL_TRANSCRIPT_B_TO_A=請確認防呆治具。
LOCAL_EVAL_CONFIDENCE=0.99
LOCAL_EVAL_TRANSLATION_MODE=preserve

# browser_pair is the two-phone WebSocket path. fake_telephony is an in-process
# test seam only; it is not a SIP/PSTN/carrier connection.
MEDIA_PROFILE=browser_pair
TRANSLATION_PROFILE=glossary_controlled
EVIDENCE_PROFILE=encrypted_local
EVIDENCE_DIRECTORY=./data/evidence
GLOSSARY_DIRECTORY=./data/glossaries

# 32 random bytes encoded as base64. Generate with: pnpm keygen
EVIDENCE_KEY_BASE64=
LOG_LEVEL=info
