HOST=0.0.0.0
PORT=4207
PUBLIC_BASE_URL=http://localhost:4207
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional 32+ character bearer secret for the operator UI. When omitted, a
# fresh random token is generated at startup and printed only in operatorUrl.
OPERATOR_TOKEN=

# Required for OpenAI-backed profiles. Never expose this key to browsers.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

MEDIA_PROFILE=browser_pair
TRANSLATION_PROFILE=glossary_controlled
EVIDENCE_PROFILE=encrypted_local
EVIDENCE_DIRECTORY=./data/evidence
GLOSSARY_DIRECTORY=./data/glossaries

# 32 random bytes encoded as base64. Generate with: pnpm keygen
EVIDENCE_KEY_BASE64=
LOG_LEVEL=info
